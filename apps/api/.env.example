# ===== 必填环境变量 ======
# 每个队列的工作进程数。
# 想提高吞吐量可以增大；如果机器 CPU 较弱则建议调低。
NUM_WORKERS_PER_QUEUE=8
# API 容器对外暴露的 HTTP 端口。
PORT=3002
# API 服务绑定的监听地址。
HOST=0.0.0.0
# Redis 连接串，用于队列、缓存和通用运行时状态。
# Docker Compose 环境请使用 redis://redis:6379；本地直接运行请使用 redis://localhost:6379。
REDIS_URL=redis://redis:6379 # Docker Compose 环境使用 redis://redis:6379，本地运行使用 redis://localhost:6379
# Redis 连接串，专门用于限流计数。
# Docker Compose 环境请使用 redis://redis:6379；本地直接运行请使用 redis://localhost:6379。
REDIS_RATE_LIMIT_URL=redis://redis:6379 # Docker Compose 环境使用 redis://redis:6379，本地运行使用 redis://localhost:6379
# Playwright 抓取微服务地址，用于浏览器渲染类抓取。
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

## 如需开启数据库认证，需要先配置 Supabase。
# 是否启用基于数据库的认证及相关鉴权流程。
USE_DB_AUTHENTICATION=true

# ===== 可选环境变量 ======

# SearchApi 的 API Key，可前往 https://searchapi.com/ 获取。
SEARCHAPI_API_KEY=
# SearchApi 使用的搜索引擎，默认是 google。可选如 google、bing、baidu、google_news 等，详见 https://searchapi.com/ 。
SEARCHAPI_ENGINE=

## === 并发与性能设置 ===
# 每个队列的工作进程数，用于控制任务并行处理能力。
# 大多数部署建议设置为 4-8，并根据 CPU 核数调整。
# 这里重复列出一次，便于集中查看性能相关参数。
NUM_WORKERS_PER_QUEUE=8
# 单次 crawl 过程中允许的并发请求/页面数。
# 想提高吞吐量可以调高；大多数机器建议 8-16，高性能服务器可设置到 32+。
CRAWL_CONCURRENT_REQUESTS=10

# 最大同时运行的 crawl 作业数。
# 用来限制系统同一时间能执行多少个 crawl 任务。
MAX_CONCURRENT_JOBS=5

# Playwright 服务中的浏览器实例池大小。
# 值越大，可并行执行的浏览器操作越多。
BROWSER_POOL_SIZE=5

# Supabase 配置，用于数据库认证、高级日志等能力。
# Supabase 客户端可使用的匿名公开令牌。
SUPABASE_ANON_TOKEN=
# 你的 Supabase 项目基础 URL。
SUPABASE_URL=
# 服务器端高权限操作使用的 Supabase service-role 令牌。
SUPABASE_SERVICE_TOKEN=

# 其他可选项
# 如果你已经配置了认证，并希望用真实 API Key 进行测试，可填写此项。
TEST_API_KEY=
# 用于测试 scraping 接口限流。
RATE_LIMIT_TEST_API_KEY_SCRAPE=
# 用于测试 crawling 接口限流。
RATE_LIMIT_TEST_API_KEY_CRAWL=
# ScrapingBee 的 API Key，目标站点反爬较强时会比较有用。
SCRAPING_BEE_API_KEY=
# 供依赖 LLM 的功能使用，例如结构化提取、图片 alt 文本生成、摘要等。
OPENAI_API_KEY=
# 如果你暴露了 Bull Board 队列管理界面，可在这里配置认证密码/密钥。
BULL_AUTH_KEY=@
# 如果你希望用 LlamaParse 解析 PDF，可在这里配置其 API Key。
LLAMAPARSE_API_KEY=
# 如果你希望把服务健康状态消息发送到 Slack，可配置此 Webhook。
SLACK_WEBHOOK_URL=
# PostHog 项目的 API Key，用于事件采集和分析。
POSTHOG_API_KEY=
# PostHog 服务地址，例如 https://app.posthog.com 或你自建的实例地址。
POSTHOG_HOST=

# Stripe 中 Standard 套餐的价格 ID。
STRIPE_PRICE_ID_STANDARD=
# Stripe 中 Scale 套餐的价格 ID。
STRIPE_PRICE_ID_SCALE=
# Stripe 中 Starter 套餐的价格 ID。
STRIPE_PRICE_ID_STARTER=
# Stripe 中 Hobby 月付套餐的价格 ID。
STRIPE_PRICE_ID_HOBBY=
# Stripe 中 Hobby 年付套餐的价格 ID。
STRIPE_PRICE_ID_HOBBY_YEARLY=
# Stripe 中新版 Standard 月付套餐的价格 ID。
STRIPE_PRICE_ID_STANDARD_NEW=
# Stripe 中新版 Standard 年付套餐的价格 ID。
STRIPE_PRICE_ID_STANDARD_NEW_YEARLY=
# Stripe 中 Growth 月付套餐的价格 ID。
STRIPE_PRICE_ID_GROWTH=
# Stripe 中 Growth 年付套餐的价格 ID。
STRIPE_PRICE_ID_GROWTH_YEARLY=

# 如果你要接入 Fire Engine 封闭测试版，可在这里配置地址。
FIRE_ENGINE_BETA_URL=

# 如果你希望优先使用 Brave Search API，再在失败时回退到 DuckDuckGo，可填写这里。
BRAVE_SEARCH_API_KEY=
# 当 Brave 报告配额耗尽后，在再次探测前跳过 Brave 的秒数。
BRAVE_SEARCH_QUOTA_BLOCK_SECONDS=21600

# Playwright 代理设置。
# 也可以接入类似 Oxylabs 这类会自动轮换 IP 的代理服务。
# Playwright 浏览器会话使用的代理服务器地址。
PROXY_SERVER=
# 当前代理的用户名。
PROXY_USERNAME=
# 当前代理的密码。
PROXY_PASSWORD=
# 是否拦截媒体资源请求，以节省代理带宽。
BLOCK_MEDIA=

# 自托管 FireCrawl 时，你自己的 webhook 接收地址。
SELF_HOSTED_WEBHOOK_URL=

# 自托管 FireCrawl 时，用于 webhook 签名校验的 HMAC 密钥。
SELF_HOSTED_WEBHOOK_HMAC_SECRET=

# Resend 的 API Key，用于发送事务性邮件。
RESEND_API_KEY=

# LOGGING_LEVEL 用于控制系统输出日志的详细程度。
# 可选值如下：
# NONE - 不输出日志。
# ERROR - 仅输出表示操作失败的错误日志。
# WARN - 输出潜在风险但不一定是错误的问题。
# INFO - 输出运行过程中的一般信息。
# DEBUG - 输出用于排查问题的详细调试信息。
# TRACE - 输出比 DEBUG 更细的追踪信息。
# 将 LOGGING_LEVEL 设置为上述之一即可控制日志粒度。
LOGGING_LEVEL=INFO



# x402 支付配置
# 接收 x402 支付的收款钱包地址。
X402_PAY_TO_ADDRESS=
                    # ^ 地址可从 https://portfolio.metamask.io/ 获取
# x402 结算所使用的区块链网络。
X402_NETWORK=base-sepolia
# 用于校验和路由 x402 支付的 facilitator 服务地址。
X402_FACILITATOR_URL=https://x402.org/facilitator
# 是否启用 x402 付费端点。
X402_ENABLED=true
# x402 校验请求的超时时间，单位为毫秒。
X402_VERIFICATION_TIMEOUT=30000

# 用于 x402 相关集成的 Coinbase CDP API Key ID。
CDP_API_KEY_ID=""
# 用于 x402 相关集成的 Coinbase CDP API Key Secret。
CDP_API_KEY_SECRET=""
                  # ^ 密钥可从 https://portal.cdp.coinbase.com/projects/api-keys 获取

## 端点定价测试：$0.01
# 示例 x402 付费端点收取的美元价格。
X402_ENDPOINT_PRICE_USD=0.01