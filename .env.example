# Firecrawl 环境配置示例
# 复制此文件为 .env 并按需修改。

# Firecrawl API 对外提供服务的端口。
PORT=3002

# API 容器内部监听端口，通常保持默认即可。
INTERNAL_PORT=3002
# 提取任务 Worker 的内部监听端口。
EXTRACT_WORKER_PORT=3004
# 通用 Worker 的内部监听端口。
WORKER_PORT=3005

# 每个队列的工作进程数。
NUM_WORKERS_PER_QUEUE=8
# 单次 crawl 任务允许的并发请求/页面数。
CRAWL_CONCURRENT_REQUESTS=10
# 系统允许同时运行的最大 crawl 作业数。
MAX_CONCURRENT_JOBS=5
# Playwright 浏览器实例池大小。
BROWSER_POOL_SIZE=5

# PostgreSQL 用户名。
POSTGRES_USER=firecrawl
# PostgreSQL 密码。
POSTGRES_PASSWORD=firecrawl_password
# PostgreSQL 数据库名。
POSTGRES_DB=firecrawl
# PostgreSQL 主机名，在 Docker Compose 中通常是服务名。
POSTGRES_HOST=nuq-postgres
# PostgreSQL 端口。
POSTGRES_PORT=5432
# 是否启用基于数据库的认证。
USE_DB_AUTHENTICATION=false

# Redis 连接串，用于队列、缓存和运行时状态。
REDIS_URL=redis://redis:6379
# Redis 连接串，用于限流计数。
REDIS_RATE_LIMIT_URL=redis://redis:6379

# Playwright 抓取微服务地址，用于浏览器渲染类抓取。
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape
# 是否拦截媒体资源请求，以节省带宽和代理成本。
BLOCK_MEDIA=

# 用于结构化提取、摘要等依赖 LLM 的功能的 API Key。
OPENAI_API_KEY=your-siliconflow-api-key
# OpenAI 兼容接口地址，这里默认指向 SiliconFlow。
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# 默认使用的大语言模型名称。
MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507
# 嵌入模型名称；不使用向量能力时可留空。
MODEL_EMBEDDING_NAME=
# Ollama 服务地址；仅在使用本地 Ollama 模型时需要配置。
OLLAMA_BASE_URL=

# 日志级别，可选如 debug、info、warn、error。
LOGGING_LEVEL=info

# 是否允许回调到本地地址，便于本地开发调试 webhook。
ALLOW_LOCAL_WEBHOOKS=true
# 自托管环境下接收 webhook 的地址。
SELF_HOSTED_WEBHOOK_URL=

# Playwright 或抓取流程使用的代理服务器地址。
PROXY_SERVER=
# 代理用户名。
PROXY_USERNAME=
# 代理密码。
PROXY_PASSWORD=

# Autumn 相关密钥，只有接入对应计费/授权逻辑时才需要。
AUTUMN_SECRET_KEY=
# Slack Webhook 地址，用于发送服务状态或告警消息。
SLACK_WEBHOOK_URL=
# Bull Board 或队列管理界面的认证密钥。
BULL_AUTH_KEY=
# 用于测试鉴权流程的 API Key。
TEST_API_KEY=

# Supabase 项目地址。
SUPABASE_URL=
# Supabase 匿名公开令牌。
SUPABASE_ANON_TOKEN=
# Supabase 服务端高权限令牌。
SUPABASE_SERVICE_TOKEN=

# Brave Search API Key；配置后会优先使用 Brave 搜索。
BRAVE_SEARCH_API_KEY=
# Brave 配额耗尽后，熔断并跳过 Brave 的秒数。
BRAVE_SEARCH_QUOTA_BLOCK_SECONDS=21600
# SearXNG 服务地址；配置后可作为搜索后端之一。
SEARXNG_ENDPOINT=
# SearXNG 启用的搜索引擎列表，通常用逗号分隔。
SEARXNG_ENGINES=
# SearXNG 搜索分类列表，通常用逗号分隔。
SEARXNG_CATEGORIES=
